# So where? environment variables. Names only: copy to .env.local and fill in your own values.
# Never commit .env.local. Model names have working defaults in the code; leave them blank unless you want to override.

# --- Needed for live plans ---
GEMINI_API_KEY=
# MongoDB Atlas connection string (venues, events, line_status, plan_runs). Without it the planner falls back to
# Overpass and the bundled OSM snapshot, and the Atlas steps are skipped.
MONGODB_URI=
# Database name (default: sowhere)
MONGODB_DB=

# --- Optional ---
# TfL Unified API key (works without one, at a lower rate limit)
TFL_APP_KEY=

# Planner (Argon pick + verify loop)
PLAN_MODEL=
PLAN_ARGON=
PLAN_PICK_THINKING=
PLAN_VERIFY_THINKING=
PLAN_GUARD_MS=
GEMINI_MODEL=

# Vision (Snap a place / poster)
VISION_MODEL=

# Voice and translation
LIVE_MODEL=
LIVE_VOICE=
NEXT_PUBLIC_LIVE_VOICE=
TRANSLATE_MODEL=
TTS=
TTS_MODEL=

# Venue blurbs and vibe search
BLURBS=
BLURB_MODEL=
VIBE=
VIBE_EMBED=
VIBE_EMBED_MODEL=

# Live OSM fallback
OVERPASS_URL=
OVERPASS_URLS=

# Atlas Stream Processing setup only (scripts/asp-setup.sh)
SP_CLUSTER_CONN=
SP_NAME=
SP_TFL_CONN=

# Pre-existing base app only (legacy /review and /events sign-in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
